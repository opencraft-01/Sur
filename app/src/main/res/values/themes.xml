<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Window-level theme only. Every screen is Compose and takes its colours from
        MaterialTheme (dynamic colour on Android 12+, brand scheme otherwise).
        Material Views stay on the classpath because CS3 extensions may inflate them.
    -->
    <style name="Theme.PrimeBox" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
</resources>
